rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }
    function owns(data) {
      return signedIn() && data.userId == request.auth.uid;
    }
    // Pinned Unicode 15.0.0 SIMPLE case folding (C/S) is used by the client.
    // This guard excludes every noncanonical source, including long s/final sigma.
    // Uppercase ASCII E is excluded, so a key cannot contain the RE2 quote terminator.
    // RE2 uses an older fold table for these nine historical Cyrillic letters.
    function compatibleName(name) {
      return name.replace('ᲀ', 'в').replace('ᲁ', 'д').replace('ᲂ', 'о')
        .replace('ᲃ', 'с').replace('ᲄ', 'т').replace('ᲅ', 'т')
        .replace('ᲆ', 'ъ').replace('ᲇ', 'ѣ').replace('ᲈ', 'ꙋ');
    }
    function canonicalNameKey(data) {
      return data.nameKey is string
        && data.nameKey.matches('[^A-ZµÀ-ÖØ-ÞĀĂĄĆĈĊČĎĐĒĔĖĘĚĜĞĠĢĤĦĨĪĬĮĲĴĶĹĻĽĿŁŃŅŇŊŌŎŐŒŔŖŘŚŜŞŠŢŤŦŨŪŬŮŰŲŴŶŸŹŻŽſƁƂƄƆƇƉ-ƋƎ-ƑƓƔƖ-ƘƜƝƟƠƢƤƦƧƩƬƮƯƱ-ƳƵƷƸƼǄǅǇǈǊǋǍǏǑǓǕǗǙǛǞǠǢǤǦǨǪǬǮǱǲǴǶ-ǸǺǼǾȀȂȄȆȈȊȌȎȐȒȔȖȘȚȜȞȠȢȤȦȨȪȬȮȰȲȺȻȽȾɁɃ-ɆɈɊɌɎͅͰͲͶͿΆΈ-ΊΌΎΏΑ-ΡΣ-ΫςϏ-ϑϕϖϘϚϜϞϠϢϤϦϨϪϬϮϰϱϴϵϷϹϺϽ-ЯѠѢѤѦѨѪѬѮѰѲѴѶѸѺѼѾҀҊҌҎҐҒҔҖҘҚҜҞҠҢҤҦҨҪҬҮҰҲҴҶҸҺҼҾӀӁӃӅӇӉӋӍӐӒӔӖӘӚӜӞӠӢӤӦӨӪӬӮӰӲӴӶӸӺӼӾԀԂԄԆԈԊԌԎԐԒԔԖԘԚԜԞԠԢԤԦԨԪԬԮԱ-ՖႠ-ჅჇჍᏸ-ᏽᲀ-ᲈᲐ-ᲺᲽ-ᲿḀḂḄḆḈḊḌḎḐḒḔḖḘḚḜḞḠḢḤḦḨḪḬḮḰḲḴḶḸḺḼḾṀṂṄṆṈṊṌṎṐṒṔṖṘṚṜṞṠṢṤṦṨṪṬṮṰṲṴṶṸṺṼṾẀẂẄẆẈẊẌẎẐẒẔẛẞẠẢẤẦẨẪẬẮẰẲẴẶẸẺẼẾỀỂỄỆỈỊỌỎỐỒỔỖỘỚỜỞỠỢỤỦỨỪỬỮỰỲỴỶỸỺỼỾἈ-ἏἘ-ἝἨ-ἯἸ-ἿὈ-ὍὙὛὝὟὨ-Ὧᾈ-ᾏᾘ-ᾟᾨ-ᾯᾸ-ᾼιῈ-ῌῘ-ΊῨ-ῬῸ-ῼΩKÅℲⅠ-ⅯↃⒶ-ⓏⰀ-ⰯⱠⱢ-ⱤⱧⱩⱫⱭ-ⱰⱲⱵⱾ-ⲀⲂⲄⲆⲈⲊⲌⲎⲐⲒⲔⲖⲘⲚⲜⲞⲠⲢⲤⲦⲨⲪⲬⲮⲰⲲⲴⲶⲸⲺⲼⲾⳀⳂⳄⳆⳈⳊⳌⳎⳐⳒⳔⳖⳘⳚⳜⳞⳠⳢⳫⳭⳲꙀꙂꙄꙆꙈꙊꙌꙎꙐꙒꙔꙖꙘꙚꙜꙞꙠꙢꙤꙦꙨꙪꙬꚀꚂꚄꚆꚈꚊꚌꚎꚐꚒꚔꚖꚘꚚꜢꜤꜦꜨꜪꜬꜮꜲꜴꜶꜸꜺꜼꜾꝀꝂꝄꝆꝈꝊꝌꝎꝐꝒꝔꝖꝘꝚꝜꝞꝠꝢꝤꝦꝨꝪꝬꝮꝹꝻꝽꝾꞀꞂꞄꞆꞋꞍꞐꞒꞖꞘꞚꞜꞞꞠꞢꞤꞦꞨꞪ-ꞮꞰ-ꞴꞶꞸꞺꞼꞾꟀꟂꟄ-ꟇꟉꟐꟖꟘꟵꭰ-ꮿＡ-Ｚ𐐀-𐐧𐒰-𐓓𐕰-𐕺𐕼-𐖊𐖌-𐖒𐖔𐖕𐲀-𐲲𑢠-𑢿𖹀-𖹟𞤀-𞤡]*')
        && compatibleName(data.name.trim()).matches('(?i)\\Q' + data.nameKey + '\\E');
    }
    // One recipe name per owner, independent of Unicode letter case.
    function canonicalId(data) {
      return data.userId + '_'
        + hashing.sha256(data.nameKey).toHexString().lower();
    }
    function validRecipe(data, recipeId) {
      return data.keys().hasAll([
          'id', 'userId', 'name', 'category', 'difficulty', 'cookTime',
          'favorite', 'createdAt', 'nameKey'
        ])
        && data.keys().hasOnly([
          'id', 'userId', 'name', 'category', 'difficulty', 'cookTime',
          'servings', 'favorite', 'notes', 'createdAt', 'nameKey'
        ])
        && data.id is string && data.id == recipeId
        && data.userId is string && owns(data)
        && data.name is string
        && data.name.trim().size() > 0 && data.name.size() <= 80
        && canonicalNameKey(data)
        && data.category in ['Breakfast', 'Lunch', 'Dinner', 'Dessert']
        && data.difficulty in ['Easy', 'Medium', 'Hard']
        && data.cookTime is int && data.cookTime >= 1 && data.cookTime <= 600
        && (!('servings' in data) || data.servings == null
          || (data.servings is int && data.servings >= 1 && data.servings <= 20))
        && data.favorite is bool
        && (!('notes' in data) || (data.notes is string && data.notes.size() <= 300))
        && data.createdAt is timestamp
        && recipeId == canonicalId(data);
    }
    match /recipes/{recipeId} {
      // Transactions may check a vacant target; existing recipes remain private.
      allow get: if signedIn()
        && (!exists(/databases/$(database)/documents/recipes/$(recipeId)) || owns(resource.data));
      allow list: if owns(resource.data);
      allow create: if validRecipe(request.resource.data, recipeId)
        && request.resource.data.createdAt <= request.time;
      allow update: if owns(resource.data)
        && validRecipe(request.resource.data, recipeId)
        && request.resource.data.userId == resource.data.userId
        && request.resource.data.createdAt == resource.data.createdAt;
      allow delete: if owns(resource.data);
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
