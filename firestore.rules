rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }
    function owns(data) {
      return signedIn() && data.userId == request.auth.uid;
    }
    // One recipe name per owner, independent of case and surrounding spaces.
    function canonicalId(data) {
      return data.userId + '_'
        + hashing.sha256(data.name.trim().lower()).toHexString().lower();
    }
    function validRecipe(data, recipeId) {
      return data.keys().hasAll([
          'id', 'userId', 'name', 'category', 'difficulty', 'cookTime',
          'favorite', 'createdAt'
        ])
        && data.keys().hasOnly([
          'id', 'userId', 'name', 'category', 'difficulty', 'cookTime',
          'servings', 'favorite', 'notes', 'createdAt'
        ])
        && data.id is string && data.id == recipeId
        && data.userId is string && owns(data)
        && data.name is string
        && data.name.trim().size() > 0 && data.name.size() <= 80
        && data.category in ['Breakfast', 'Lunch', 'Dinner', 'Dessert']
        && data.difficulty in ['Easy', 'Medium', 'Hard']
        && data.cookTime is int && data.cookTime >= 1 && data.cookTime <= 600
        && (!('servings' in data) || data.servings == null
          || (data.servings is int && data.servings >= 1 && data.servings <= 20))
        && data.favorite is bool
        && (!('notes' in data) || (data.notes is string && data.notes.size() <= 300))
        && data.createdAt is timestamp
        && recipeId == canonicalId(data);
    }
    match /recipes/{recipeId} {
      // Transactions may check a vacant target; existing recipes remain private.
      allow get: if signedIn()
        && (!exists(/databases/$(database)/documents/recipes/$(recipeId)) || owns(resource.data));
      allow list: if owns(resource.data);
      allow create: if validRecipe(request.resource.data, recipeId)
        && request.resource.data.createdAt <= request.time;
      allow update: if owns(resource.data)
        && validRecipe(request.resource.data, recipeId)
        && request.resource.data.userId == resource.data.userId
        && request.resource.data.createdAt == resource.data.createdAt;
      allow delete: if owns(resource.data);
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
